# Copiez ce fichier en `.env.local` et renseignez vos clés Supabase pour activer
# la synchronisation cloud, l'authentification et la base communautaire.
#
# Sans ces variables, BoardScore AI fonctionne intégralement en mode local
# (IndexedDB) : parties, scores et modèles de jeux restent sur l'appareil.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
